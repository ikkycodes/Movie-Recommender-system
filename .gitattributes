*.pkl filter=lfs diff=lfs merge=lfs -text

# movies_list.pkl is committed as a regular ~3 MB file, not as a Git LFS
# pointer. Without opting it out of the LFS filter above, every clone prints
# "Encountered 1 file that should have been a pointer, but wasn't" and reports
# the file as modified even when nothing has changed.
movies_list.pkl -filter -diff -merge -text
